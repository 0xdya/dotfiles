{
    "window.titleBarStyle": "native",
    "workbench.browser.showInTitleBar": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.viewSessions.enabled": false,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.suggestOnTriggerCharacters": true,
    "editor.hover.enabled": "off",
    "editor.suggest.showHover": false,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.wordBasedSuggestions": "matchingDocuments",
    "emmet.showAbbreviationSuggestions": true,
    "editor.inlineSuggest.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.nextEditSuggestions.extendedRange": false,
    "github.copilot.editor.enableAutoCompletions": false,
    "diffEditor.ignoreTrimWhitespace": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "git.autofetch": true,
    "security.workspace.trust.untrustedFiles": "open",
    "editor.spellCheck.enabled": false,
    "keyboard.dispatch": "keyCode",
    "chat.tools.terminal.autoApprove": {
        "/^node --check docs/js/user\\.js$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "workbench.preferredLightColorTheme": "Kimbie Dark",
    "workbench.navigationControl.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.activityBar.location": "top",
    "window.menuBarVisibility": "hidden",
    "workbench.welcomePage.extraAnnouncements": false,
    "accessibility.verbosity.newSessionWelcome": false,
    "workbench.startupEditor": "none"
}
